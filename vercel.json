{
  "buildCommand": "npm run build:vercel-output",
  "outputDirectory": "dist",
  "functions": {
    "api/private-content.js": {
      "includeFiles": "{**/*.pdf,content/**/*,ui/**/*,central-structural-v*/**/*.js,tools/*.{js,html},*-theory-*.js,*-full-theory-*.js,adm-m*-*.js,cpp-course-*.js,portugues-*.{js,html},portugues-autodidata-data.txt,portugues-native-data/*.js,audits/**/*.json}"
    },
    "api/lei-em-dia-questions.js": {
      "includeFiles": "lei-em-dia-aprovadas-20261012.js"
    }
  },
  "rewrites": [
    {
      "source": "/central-de-questoes",
      "destination": "/central-v119.html"
    }
  ],
  "redirects": [
    {
      "source": "/portugues",
      "destination": "/portugues.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/central-v119.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/central-v119.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/central-boot-ready.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
