{
  "buildCommand": "npm run build:vercel-output",
  "outputDirectory": "dist",
  "functions": {
    "api/private-content.js": {
      "includeFiles": "{**/*.pdf,content/**/*,ui/**/*,central-structural-v*/**/*questions*.js,central-structural-v*/civil-course-*.js,tools/decorando-data-*.js,tools/cronograma.html,tools/rlm.html,*-full-theory-*.js,*-theory-module*.js,adm-m*-content-*.js,adm-m*-theory-*.js,cpp-course-data-*.js,cpp-course-core-v1.js,portugues-m*-runtime-v*.js,portugues-m2-tec-link-v1.js,portugues-m3-preview-v1.html,portugues-native-data/*.js,portugues-autodidata-data.txt,audits/qc-integral-20261019/**/*.json}"
    },
    "api/lei-em-dia-questions.js": {
      "includeFiles": "lei-em-dia-aprovadas-20261012.js"
    }
  },
  "rewrites": [
    {
      "source": "/central-de-questoes",
      "destination": "/central-v119.html"
    }
  ],
  "redirects": [
    {
      "source": "/portugues",
      "destination": "/portugues.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/central-v119.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/central-v119.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/central-boot-ready.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
