{
  "buildCommand": "npm run build:vercel-output",
  "outputDirectory": "dist",
  "functions": {
    "api/auth.js": {
      "includeFiles": "{**/*.pdf,content/**/*,ui/**/*,central-structural-v*/**/*.js,tools/*.{js,html},*-theory-*.js,*-full-theory-*.js,adm-m*-*.js,cpp-course-*.js,portugues-*,portugues-native-data/*.js,audits/**/*.json,lei-em-dia-*.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/premium-expiry-reminders",
      "destination": "/api/auth?bc_api=premium-expiry-reminders"
    },
    {
      "source": "/api/hotmart-webhook",
      "destination": "/api/auth?bc_api=hotmart-webhook"
    },
    {
      "source": "/api/hotmart-claim",
      "destination": "/api/auth?bc_api=hotmart-claim"
    },
    {
      "source": "/api/plans",
      "destination": "/api/auth?bc_api=plans"
    },
    {
      "source": "/api/private-content",
      "destination": "/api/auth?bc_api=private-content"
    },
    {
      "source": "/api/lei-em-dia-questions",
      "destination": "/api/auth?bc_api=lei-em-dia-questions"
    },
    {
      "source": "/central-de-questoes",
      "destination": "/central-v119.html"
    }
  ],
  "redirects": [
    {
      "source": "/portugues",
      "destination": "/portugues.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/central-v119.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/central-v119.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/central-boot-ready.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/premium-expiry-reminders",
      "schedule": "0 12 * * *"
    }
  ]
}
